{
	# Email для уведомлений Let's Encrypt (истечение/проблемы с продлением).
	# Необязателен, но рекомендуется. Задаётся через ACME_EMAIL в .env.
	email {$ACME_EMAIL}
}

# Домен берётся из DOMAIN в .env. Caddy сам получает и продлевает
# сертификат Let's Encrypt для него — руками ничего настраивать не нужно,
# достаточно, чтобы DNS домена уже указывал на IP этого сервера.
{$DOMAIN} {
	reverse_proxy app:3000
}

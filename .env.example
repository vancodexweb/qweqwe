# Скопируйте этот файл в .env и заполните значения перед запуском.
# Подробное описание каждой переменной — в README.md, раздел "Пошаговая настройка окружения".

# ---------------------------------------------------------------------------
# Приложение
# ---------------------------------------------------------------------------

# development | production. В development отключается Secure-флаг у cookie
# (иначе браузер не примет их по обычному http://localhost).
NODE_ENV=development

# Порт, на котором NestJS слушает HTTP.
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_USER=auth_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=auth_app

# Полная строка подключения для Prisma. Используется, когда приложение
# запускается НЕ через docker-compose (например, `npm run start:dev` на хосте) —
# тогда Postgres слушает на localhost, т.к. порт 5432 контейнера проброшен наружу.
# Внутри docker-compose (сервис app) эта переменная автоматически
# переопределяется на хост "postgres" — см. environment: в docker-compose.yml.
DATABASE_URL=postgresql://auth_app:change_me_strong_password@localhost:5432/auth_app?schema=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Так же, как и DATABASE_URL: для docker-compose (сервис app) хост
# автоматически переопределяется на "redis". Значение ниже — для запуска на хосте.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------

# Секреты ДОЛЖНЫ быть не короче 32 символов и отличаться друг от друга.
# Сгенерировать можно так: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_characters_and_different
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Токен бота, выданный @BotFather (см. README, раздел "Получение TELEGRAM_BOT_TOKEN").
TELEGRAM_BOT_TOKEN=123456789:AAABBBcccDDDeeeFFFggghhhIIIjjjKKKllL

# Username бота без @, например для @my_auth_bot — просто my_auth_bot.
TELEGRAM_BOT_USERNAME=my_auth_bot

# Произвольная строка, известная только вам и Telegram. Передаётся в setWebhook
# и сверяется на каждом входящем вебхуке (заголовок X-Telegram-Bot-Api-Secret-Token).
# Сгенерировать можно так: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change_me_webhook_secret_minimum_16_characters

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------

# Базовый URL фронтенда. Используется для построения ссылки в inline-кнопке
# Telegram-бота (.../auth/telegram/confirm?code=...).
FRONTEND_URL=http://localhost:5173

# Список разрешённых origin для CORS через запятую, без пробелов и без "*" в проде.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------

# Домен, на который будут выставляться cookie с токенами. Для локальной
# разработки можно оставить пустым (браузер сам подставит host запроса).
COOKIE_DOMAIN=
